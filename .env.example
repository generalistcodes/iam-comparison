# Copy to .env: cp .env.example .env

COMPOSE_PROJECT_NAME=iam-opensource

# Portainer (always running)
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# Shared image defaults
POSTGRES_IMAGE=postgres:17-alpine

# Keycloak — http://localhost:8080/admin
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.1.4

# Zitadel — http://localhost:8081/ui/console
ZITADEL_HTTP_PORT=8081
ZITADEL_LOGIN_PORT=3001
ZITADEL_MASTERKEY=MasterkeyNeeds32Characters123456
ZITADEL_DB_ADMIN_USER=postgres
ZITADEL_DB_ADMIN_PASSWORD=postgres
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=zitadel
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.13.0
ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.13.0

# Authentik — http://localhost:9090
AUTHENTIK_HTTP_PORT=9090
AUTHENTIK_HTTPS_PORT=9444
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key-min-50-chars-long!!
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.10.4

# Gluu — https://localhost:8443 (add "127.0.0.1 demoexample.gluu.org" to /etc/hosts)
GLUU_HTTP_PORT=8083
GLUU_HTTPS_PORT=8443
GLUU_HOSTNAME=demoexample.gluu.org
GLUU_ADMIN_PASSWORD=1t5Fin3#security
GLUU_ORG_NAME=Gluu
GLUU_EMAIL=team@gluu.org
GLUU_DB_USER=gluu
GLUU_DB_PASSWORD=1t5Fin3#security
GLUU_DB_NAME=gluu
GLUU_IMAGE=ghcr.io/gluufederation/flex/monolith:0.0.0-nightly
